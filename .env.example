# ==========================================
# MUSE2API environment configuration example
# Copy to .env to activate: cp .env.example .env
# ==========================================

# [required/optional] Admin and API authentication key (starts with m2a_).
# If left empty, the program generates a strong random key on first start and prints it to the console log.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# [optional] Separate credential for code-changing admin actions:
#   POST /admin/update/upgrade   (pull new code and restart)
#   POST /admin/repo/push        (publish code to the upstream GitHub repo)
# The API key above is handed to every downstream client, so it should not be able to
# publish code. Leave this empty and /admin/repo/push stays disabled (403), while
# /admin/update/upgrade keeps accepting the API key and logs a warning at startup.
MUSE2API_MAINTAINER_KEY=

# Service listen address and port (use 0.0.0.0 inside a Docker container)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# External public URL (used by downstream clients and for admin-page URL construction, e.g. https://api.yourdomain.com)
# When empty, the admin page automatically uses the host and port the browser is currently visiting
MUSE2API_PUBLIC_BASE=

# Path to the Chromium browser executable
# On Linux/Docker this is usually /usr/bin/chromium or /usr/bin/chromium-browser
# For local Windows runs, set the full Chrome path or leave empty for auto-discovery
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP remote-debugging port
MUSE2API_CDP_PORT=19210

# Task timeout control (seconds)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# How many tasks may run at once (default 1 = serialised). They share ONE Chromium
# process and one CDP connection, each on its own tab, so this is concurrent tab work
# rather than concurrent browsers. Raise it only if you have measured a gain: more
# slots add contention on the shared CDP connection, not more browsers.
MUSE2API_CONCURRENCY=1

# Admission caps: how many tasks of each kind may be queued or processing at once.
# Extra requests get HTTP 429 instead of spawning unbounded worker threads.
MUSE2API_IMAGE_QUEUE_MAX=8
MUSE2API_VIDEO_QUEUE_MAX=4
# Same idea for /v1/chat/completions and /v1/responses (no task record, counted
# in-flight for the full request duration including streaming).
MUSE2API_CHAT_QUEUE_MAX=16

# Keep at most this many finished task records (0 disables pruning). Each task update
# rewrites the whole tasks.json, so unbounded history slows every update.
MUSE2API_TASK_RETENTION=200

# Delete generated media older than this many days (0 = keep forever). Files still
# referenced by a queued or processing task are never deleted.
MUSE2API_MEDIA_RETENTION_DAYS=0

# Whether to run auto-keepalive for background-disabled accounts (0=off, 1=on)
# When enabled, disabled accounts still get silent keepalive and session renewal, but are not routed for normal generation or chat
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Reference-image security switches (secure by default; set to 1 explicitly only for trusted single-user deployments)
# 1: allow API requests to read server-local file paths
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1: allow API requests to download private/local URLs; 0 checks each hop and allows only public IPs
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# Proactively recycle the shared Chromium after this many hours of uptime, even if it
# is currently healthy (0 = disabled). Crash/unresponsive detection always runs
# regardless of this setting.
MUSE2API_BROWSER_MAX_UPTIME_HOURS=0

# Proactively recycle the shared Chromium after this many consecutive plain generation
# failures across image/video/chat (0 = disables this trigger only). Detects a wedged
# page/renderer that the crash/CDP-unresponsive check cannot see on its own.
MUSE2API_BROWSER_MAX_CONSECUTIVE_FAILURES=5
